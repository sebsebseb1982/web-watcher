{
  "name": "web-watcher",
  "version": "2.0.0",
  "description": "Surveille la valeur d'un élément (sélecteur CSS) sur des pages web",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --use-env-proxy --disable-warning=ExperimentalWarning dist/server.js"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.0.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.0"
  }
}
